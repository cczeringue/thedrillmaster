{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/VIP",
      "destination": "/VIP/index.html"
    },
    {
      "source": "/VIP/",
      "destination": "/VIP/index.html"
    },
    {
      "source": "/vip",
      "destination": "/VIP/index.html"
    },
    {
      "source": "/vip/",
      "destination": "/VIP/index.html"
    }
  ],
  "headers": [
    {
      "source": "/VIP",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/VIP/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/VIP/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/api/vip-rsvp",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/vip",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/vip/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "functions": {
    "api/vip-rsvp.js": {
      "maxDuration": 120
    }
  },
  "redirects": [
    {
      "source": "/shows/the-elysian-october-13-2026",
      "destination": "/shows/the-elysian-october-13-2026/",
      "permanent": true
    },
    {
      "source": "/shows/the-elysian-october-13-2026/index.html",
      "destination": "/shows/the-elysian-october-13-2026/",
      "permanent": true
    }
  ]
}
